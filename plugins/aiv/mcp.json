{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aiv": {
      "type": "streamable-http",
      "url": "https://aiv.piotrlitwa.com/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["aiv:read"],
            "defaultScopes": ["aiv:read", "aiv:write"]
          }
        }
      }
    }
  }
}
